# ==========================================
# GitAuto Environment Configuration Template
# ==========================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Security & Session Secrets
# Generate random 32-byte secret for session signing: openssl rand -hex 32
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Generate 32-byte base64/hex key for AES-256-GCM token encryption:
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_COOKIE_NAME=gitauto_session
SESSION_MAX_AGE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Database Configuration (PostgreSQL / Supabase / SQLite Async fallback)
# For local SQLite: sqlite+aiosqlite:///./gitauto.db
# For PostgreSQL / Supabase: postgresql+asyncpg://postgres:password@localhost:5432/gitauto
DATABASE_URL=sqlite+aiosqlite:///./gitauto.db

# Automation & Rate Limiting Engine Defaults
DEFAULT_BRANCH=main
RATE_LIMIT_WARNING_THRESHOLD=5
REQUEST_TIMEOUT_SECONDS=10.0
